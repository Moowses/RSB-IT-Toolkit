<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RSB IT Toolkit — Engineering Preview" Height="620" Width="960" WindowStartupLocation="CenterScreen" Background="#20252B" Foreground="#F4F7F9">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="RSB IT Toolkit" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="ComputerText" Margin="0,6,0,18" Foreground="#B8C4CE"/><Border Background="#563D17" Padding="10"><TextBlock Text="Engineering preview — Windows 10/11 lab validation remains required before production use." TextWrapping="Wrap"/></Border></StackPanel>
    <TabControl Grid.Row="1" Margin="0,20,0,15"><TabItem Header="Dashboard"><StackPanel Margin="18"><TextBlock Text="Safe, reversible branch-PC maintenance" FontSize="20"/><TextBlock Margin="0,12,0,0" Text="Run Preflight first. Unsupported identities and ambiguous sessions stop without change." TextWrapping="Wrap"/></StackPanel></TabItem><TabItem Header="Branch Security"><StackPanel Margin="18"><TextBlock Text="Employee account is preserved. Administrators removal happens last." TextWrapping="Wrap"/><WrapPanel Margin="0,18,0,0"><Button x:Name="PreflightButton" Content="Preflight Only" Margin="0,0,10,10" Padding="14,8"/><Button x:Name="ApplyButton" Content="Apply Branch Security Baseline" Margin="0,0,10,10" Padding="14,8"/><Button x:Name="UndoButton" Content="Undo Branch Security Baseline" Margin="0,0,10,10" Padding="14,8"/><Button x:Name="RepairButton" Content="Repair Employee Membership" Margin="0,0,10,10" Padding="14,8"/><Button x:Name="AdminVerifyButton" Content="Verify RSB IT Admin" Margin="0,0,10,10" Padding="14,8"/></WrapPanel></StackPanel></TabItem><TabItem Header="Repairs"><StackPanel Margin="18"><TextBlock Text="Repairs run in the background and record output in the toolkit log." TextWrapping="Wrap"/><WrapPanel Margin="0,18,0,0"><Button x:Name="TimeRepairButton" Content="Windows Time Repair" Margin="0,0,10,10" Padding="14,8"/><Button x:Name="NetworkRepairButton" Content="Network Repair" Margin="0,0,10,10" Padding="14,8"/><Button x:Name="SpoolerRepairButton" Content="Print Spooler Repair" Margin="0,0,10,10" Padding="14,8"/><Button x:Name="DismRepairButton" Content="DISM / SFC Repair" Margin="0,0,10,10" Padding="14,8"/></WrapPanel></StackPanel></TabItem><TabItem Header="Diagnostics"><TextBlock Margin="18" Text="System details and session/account preflight results appear below." TextWrapping="Wrap"/></TabItem><TabItem Header="Logs / History"><StackPanel Margin="18"><Button x:Name="LogsButton" Content="Open Logs" HorizontalAlignment="Left" Padding="14,8"/><TextBlock Margin="0,14,0,0" Text="State and logs are stored under %ProgramData%\RSB-IT."/></StackPanel></TabItem></TabControl>
    <Border Grid.Row="2" Background="#12161A" Padding="12"><StackPanel><TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold"/><TextBox x:Name="DetailsText" Margin="0,8,0,0" Height="100" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#12161A" Foreground="#DCE5EC" BorderThickness="0"/></StackPanel></Border>
  </Grid>
</Window>
